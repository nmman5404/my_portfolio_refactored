{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "{api/knowledge.md,src/content/blog/**/*.md}"
    },
    "api/invitation.js": {
      "includeFiles": "src/modules/ceremony/recipients.json"
    }
  }
}
