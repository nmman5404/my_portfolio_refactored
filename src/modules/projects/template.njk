{% set projects = modules.projects %}
{% set projectLabels = projects.labels[locale] %}
{% set projectPages = projects.items | batch(projects.pageSize) %}
<section id="projects" class="min-h-screen flex flex-col justify-center py-20 border-b border-gray-200 dark:border-gray-800 transition-colors duration-300 overflow-visible" data-projects data-project-page-size="{{ projects.pageSize }}">
    <div class="w-full mb-12">
        <h2 id="projects-heading" class="text-3xl font-bold text-gray-900 dark:text-white flex items-center reveal delay-100">
            <span class="text-blue-600 dark:text-blue-500 font-mono text-xl mr-2">02.</span> {{ projectLabels.heading }}
        </h2>
    </div>

    <div id="project-pages" data-project-pages aria-labelledby="projects-heading" tabindex="-1">
        {% for projectPage in projectPages %}
        <div class="projects-grid" data-project-page="{{ loop.index }}"{% if not loop.first %} hidden inert{% endif %}>
            {% for project in projectPage %}
            {% set localProject = project.locales[locale] %}
            <div class="project-item reveal delay-200">
                {% include "modules/projects/card.njk" %}
            </div>
            {% endfor %}
        </div>
        {% endfor %}
    </div>

    <nav class="projects-pagination" aria-label="{{ projectLabels.pagination }}">
        <button type="button" class="projects-page-button" data-project-previous aria-label="{{ projectLabels.previous }}" title="{{ projectLabels.previous }}" aria-controls="project-pages" disabled>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <p class="projects-page-status text-gray-600 dark:text-gray-300" data-project-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1">
            {{ projectLabels.page }} <span data-project-current-page>1</span> {{ projectLabels.of }} {{ projectPages | length }}
        </p>
        <button type="button" class="projects-page-button" data-project-next aria-label="{{ projectLabels.next }}" title="{{ projectLabels.next }}" aria-controls="project-pages"{% if projectPages | length <= 1 %} disabled{% endif %}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" /></svg>
        </button>
    </nav>
</section>
