    <!-- CHATBOT (GEMINI) -->

    <button type="button" id="chat-toggle-btn" aria-label="{{ modules.chat.controls.toggle | localized(locale) }}" aria-controls="chat-window" aria-expanded="false" class="glass-optional glass-control glass-pill glass-accent fixed bottom-6 right-6 w-14 h-14 bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg hover:shadow-blue-500/50 flex items-center justify-center transition-all duration-300 hover:-translate-y-1 z-[60]">
        <svg id="chat-icon-open" class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
        <svg id="chat-icon-close" class="w-6 h-6 absolute transition-transform duration-300 scale-0 opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <!-- Cửa sổ Chat Box -->
    <div id="chat-window" role="dialog" aria-labelledby="chat-title" aria-hidden="true" inert class="glass-surface glass-reading fixed bottom-24 right-6 w-[340px] sm:w-[400px] h-[500px] bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 flex flex-col z-[60] transition-all duration-300 transform translate-y-10 opacity-0 pointer-events-none">
        
        <!-- Header Chat -->
        <div class="chat-header p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-t-2xl flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                <div>
                    <h3 id="chat-title" class="font-bold text-gray-900 dark:text-white text-sm">{{ modules.chat.title | localized(locale) | safe }}</h3>
                    <p class="text-xs text-gray-500 dark:text-gray-400">{{ modules.chat.provider | localized(locale) | safe }}</p>
                </div>
            </div>
            <button type="button" id="chat-close-btn" aria-label="{{ modules.chat.controls.close | localized(locale) }}" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
        </div>

{% if locale == "en" %}        <!-- Khung chứa nội dung tin nhắn -->
        <!-- Đã thêm custom scrollbar cho khung chat -->
{% else %}{% endif %}        <div id="chat-messages" class="chat-messages flex-1 p-4 overflow-y-auto space-y-4 bg-white dark:bg-gray-800 scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-600">
{% if locale == "en" %}            
            <!-- Tin nhắn chào mừng tự động từ Bot -->
{% else %}{% endif %}            <div class="flex justify-start">
                <div class="chat-bubble chat-bubble-bot bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-2xl rounded-tl-sm px-4 py-2 max-w-[85%] text-sm shadow-sm">
                    {{ modules.chat.messages.welcome | localized(locale) | safe }}
                </div>
            </div>
            
        </div>

{% if locale == "en" %}        <!-- Vùng nhập tin nhắn -->
{% else %}{% endif %}        <div class="chat-composer p-3 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-b-2xl">
            <div class="relative flex items-center">
                <input type="text" id="chat-input" aria-label="{{ modules.chat.placeholder | localized(locale) }}" placeholder="{{ modules.chat.placeholder | localized(locale) }}" class="w-full pl-4 pr-12 py-3 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white transition-shadow" autocomplete="off">
                <button type="button" id="chat-send-btn" aria-label="{{ modules.chat.controls.send | localized(locale) }}" class="absolute right-2 w-8 h-8 flex items-center justify-center text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-gray-700 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                </button>
            </div>
            <p id="chat-warning" role="status" aria-live="polite" class="text-xs text-red-500 mt-2 hidden text-center"></p>
        </div>
    </div>

