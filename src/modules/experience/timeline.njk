{% set workRows = modules.experience.timeline | batch(5) %}
<h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-12 font-mono border-l-4 border-blue-500 pl-3{% if locale != 'en' %} reveal delay-100{% endif %}">{{ localized(modules.experience.workHeading, locale) | safe }}</h3>
<div class="experience-timeline relative w-full reveal delay-150" role="group" aria-label="{{ localized(modules.experience.workHeading, locale) | striptags | escape }}">
{% for row in workRows %}
    <div class="experience-timeline-row relative w-full pb-32 pt-10" data-experience-row style="--experience-node-count: {{ row | length }};">
        <div class="absolute top-[52px] left-0 w-full h-1 bg-gray-200 dark:bg-gray-700 rounded-full z-0" aria-hidden="true"></div>
        <div class="relative flex justify-between w-full z-10">
{% for item in row %}
{% include "modules/experience/node.njk" %}
{% endfor %}
        </div>
    </div>
{% endfor %}
</div>
