<section id="experience" class="min-h-screen flex flex-col justify-center py-20 border-b border-gray-200 dark:border-gray-800 transition-colors duration-300">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-12 flex items-center reveal delay-100">
                <span class="text-blue-600 dark:text-blue-500 font-mono text-xl mr-2">{{ modules.experience.number }}</span> {{ localized(modules.experience.heading, locale) | safe }}
            </h2>
{% if locale == "en" %}            <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-6 font-mono border-l-4 border-blue-500 pl-3" reveal delay-100>{{ localized(modules.experience.educationHeading, locale) | safe }}</h3>
{% else %}            <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-6 font-mono border-l-4 border-blue-500 pl-3 reveal delay-100">{{ localized(modules.experience.educationHeading, locale) | safe }}</h3>
{% endif %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20 reveal delay-150">
{% for card in modules.experience.education %}                <div class="glass-surface edu-card bg-slate-50/90 backdrop-blur-md reveal delay-{{ card.revealDelay }} dark:bg-gray-800/50 p-6 rounded-xl border border-gray-200 dark:border-gray-700 transition-all duration-300 hover:-translate-y-2 hover:border-blue-500 hover:shadow-[0_0_20px_rgba(59,130,246,0.2)] relative overflow-hidden cursor-pointer z-10">
                    <div class="w-10 h-10 bg-{{ card.color }}-100 dark:bg-{{ card.color }}-900/30 text-{{ card.color }}-600 dark:text-{{ card.color }}-400 rounded-lg flex items-center justify-center mb-4 transition-transform duration-300 hover:scale-110">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">{% for icon in card.iconPaths %}<path{{ icon.attributes | safe }}d="{{ icon.path }}"></path>{% endfor %}</svg>
                    </div>
{% if card.kind == "degree" %}{% if locale == "en" %}                    <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-1">{{ localized(card.title, locale) | safe }}</h4>
{% else %}                    <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-1">{{ localized(card.title, locale) | safe }} </h4>
{% endif %}                    <p class="text-sm text-blue-600 dark:text-blue-400 font-medium mb-3">{{ localized(card.specialization, locale) | safe }}</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">{{ localized(card.university, locale) | safe }}<br>{{ card.dates }}</p>{% elif card.kind == "certificates" %}                    <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{{ localized(card.title, locale) | safe }}</h4>
                    <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
{% for item in card.items %}                        <li><span class="font-semibold text-gray-800 dark:text-gray-200">{{ localized(item.label, locale) | safe }}</span> {{ localized(item.text, locale) | safe }}</li>
{% endfor %}                    </ul>{% else %}                    <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{{ localized(card.title, locale) | safe }} <span class="text-sm font-normal text-gray-500">{{ localized(card.titleNote, locale) | safe }}</span></h4>
                    <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-2 list-disc list-inside">
{% for item in card.items %}                        <li>{{ localized(item, locale) | safe }}</li>
{% endfor %}                    </ul>{% endif %}
                </div>{% if not loop.last %}

{% endif %}{% endfor %}
            </div>

{% include "modules/experience/timeline.njk" %}
        </section>
