{% set visibleSections = sections | activeSections(collections.publishedBlog) %}{% set navigationClass = "text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-medium transition-colors" %}<!DOCTYPE html>
<html lang="{{ locale }}" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ modules.interface.pageTitle | localized(locale) }}</title>

    <script>{{ source("modules/interface/critical/theme-bootstrap.js") }}</script>
    <script>{{ source("modules/interface/critical/glass-bootstrap.js") }}</script>

    <link rel="stylesheet" href="/assets/css/home.css">
    <link rel="stylesheet" href="/assets/css/interface.css">
    <link rel="stylesheet" href="/assets/css/tailwind.css">
</head>

<body class="text-gray-900 dark:text-gray-100 font-sans antialiased transition-colors duration-300">
    <div class="theme-bg fixed inset-0 z-[-10] w-full h-full bg-cover bg-center bg-no-repeat transition-all duration-1000">
        <div class="absolute inset-0 bg-white/60 dark:bg-gray-900/90 backdrop-blur-[2px] transition-colors duration-1000"></div>
    </div>

    {% include "components/header.njk" %}

    <main class="max-w-5xl mx-auto px-6 pt-20">
        {% for section in visibleSections %}
        {% include section.template %}
        {% endfor %}
    </main>

    {% include "modules/chat/template.njk" %}
    {% include "components/footer.njk" %}

</body>

<script type="module" src="/assets/js/home-{{ locale }}.js"></script>
</html>
