{# One visual component for article and Featured Projects summary actions. #}
{% macro summaryButton(label, accessibleLabel, prompt, busyLabel, articleId = '', title = '') %}
<button type="button" class="article-summary{% if articleId %} project-summary{% endif %}"
        {% if articleId %}data-project-summary data-summary-article="{{ articleId | escape }}" data-summary-title="{{ title | escape }}"{% else %}data-article-summary{% endif %}
        data-summary-prompt="{{ prompt | escape }}"
        data-summary-busy-label="{{ busyLabel | escape }}"
        aria-label="{{ accessibleLabel | escape }}">
    {% include "modules/contact/glow.njk" %}
    <span class="article-summary-surface glass-optional glass-control glass-pill glass-accent">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z"></path><path d="M20 3v4m-2-2h4"></path></svg>
        <span data-summary-label data-article-summary-label>{{ label | escape }}</span>
    </span>
</button>
{% endmacro %}
