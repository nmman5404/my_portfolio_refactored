{% set settingsLocale = locale or "vi" %}
{% set settingsLabels = modules.interface.settings %}
<div id="settings-control" class="settings-control">
    <button id="settings-toggle" type="button" class="settings-toggle glass-surface glass-control" aria-label="{{ settingsLabels.title | localized(settingsLocale) }}" title="{{ settingsLabels.title | localized(settingsLocale) }}" aria-expanded="false" aria-controls="settings-panel">
        <svg class="settings-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.8 3-.5 2a7 7 0 0 0-1.7 1l-2-.6-2.2 3.8 1.5 1.4a8 8 0 0 0 0 2l-1.5 1.4 2.2 3.8 2-.6a7 7 0 0 0 1.7 1l.5 2h4.4l.5-2a7 7 0 0 0 1.7-1l2 .6 2.2-3.8-1.5-1.4a8 8 0 0 0 0-2l1.5-1.4-2.2-3.8-2 .6a7 7 0 0 0-1.7-1l-.5-2Z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
    <div id="settings-panel" class="settings-panel glass-surface glass-control" role="region" aria-labelledby="settings-panel-title" hidden>
        <h2 id="settings-panel-title" class="settings-panel-title">{{ settingsLabels.title | localized(settingsLocale) }}</h2>

{% if settingsShowLanguage is not defined or settingsShowLanguage %}
        <a id="lang-switch" href="{% if settingsLocale == 'en' %}/vi{% else %}/{% endif %}" class="settings-row" role="switch" aria-checked="{% if settingsLocale == 'vi' %}true{% else %}false{% endif %}" aria-label="{{ settingsLabels.vietnamese | localized(settingsLocale) }}" title="{{ modules.interface.languageTitle | localized(settingsLocale) }}">
            <span class="settings-row-main"><svg class="settings-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a17 17 0 0 1 0 18 17 17 0 0 1 0-18Z"/></svg><span>{{ settingsLabels.language | localized(settingsLocale) }}</span></span>
            <span class="settings-row-action" aria-hidden="true"><span class="settings-language">{% if settingsLocale == 'vi' %}VI{% else %}EN{% endif %}</span><span class="settings-switch"></span></span>
        </a>
{% endif %}

        <button id="theme-toggle" type="button" class="settings-row" role="switch" aria-checked="false" title="{{ modules.interface.themeTitle | localized(settingsLocale) }}">
            <span class="settings-row-main"><span class="settings-row-icon" aria-hidden="true">
                <svg id="theme-toggle-light-icon" class="hidden settings-icon" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
                <svg id="theme-toggle-dark-icon" class="hidden settings-icon" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
            </span><span>{{ settingsLabels.darkMode | localized(settingsLocale) }}</span></span>
            <span class="settings-switch" aria-hidden="true"></span>
        </button>

{% if settingsShowAudio is not defined or settingsShowAudio %}
        <button id="music-toggle" type="button" class="settings-row" role="switch" aria-checked="false" title="{{ modules.interface.musicTitle | localized(settingsLocale) }}">
            <span class="settings-row-main"><span class="settings-row-icon" aria-hidden="true">
                <svg id="music-icon-on" class="hidden settings-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"/></svg>
                <svg id="music-icon-off" class="settings-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m17 14 4-4m-4 0 4 4"/></svg>
            </span><span>{{ settingsLabels.music | localized(settingsLocale) }}</span></span>
            <span class="settings-switch" aria-hidden="true"></span>
        </button>
{% endif %}

        <div class="settings-glass">
            <button id="glass-toggle" type="button" class="settings-row" role="switch" aria-checked="true">
                <span class="settings-row-main"><svg class="settings-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 3 8l9 5 9-5-9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5"/></svg><span>Liquid Glass</span></span>
                <span class="settings-switch" aria-hidden="true"></span>
            </button>
            <div class="settings-range">
                <div class="settings-range-label"><label for="glass-opacity">{{ settingsLabels.transparency | localized(settingsLocale) }}</label><output id="glass-value" for="glass-opacity">60%</output></div>
                <input id="glass-opacity" type="range" min="0" max="100" step="1" value="60">
            </div>
        </div>
    </div>
</div>
